<Window
    x:Class="FirstTool.Views.FirstToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:FirstTool.ViewModels"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModel:FirstToolViewModel}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Title="Column Tool"
    Height="600"
    Width="900">

    <Window.Resources>

        <CollectionViewSource
            x:Key="GroupedParameters"
            Source="{Binding Parameters}">

            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>

        </CollectionViewSource>

    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Text="Column Tool"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,15"/>


        <!-- Buttons -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <Button
                Width="120"
                Height="32"
                Margin="0,0,10,0"
                Content="Tool 1"
                Command="{Binding Tool1Command}"
                Background="#2E7D32"
                BorderBrush="#2E7D32"
                Foreground="White"/>

            <Button
                Width="120"
                Height="32"
                Content="Select Column"
                Command="{Binding Tool2Command}"
                Background="#1976D2"
                BorderBrush="#1976D2"
                Foreground="White"/>

        </StackPanel>


        <!-- Status -->
        <TextBlock
            Grid.Row="2"
            Text="{Binding StatusText}"
            Foreground="{Binding StatusColor}"
            Margin="0,0,0,10"/>


        <!-- Parameters -->
        <DataGrid
            Grid.Row="3"
            ItemsSource="{Binding Source={StaticResource GroupedParameters}}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Disabled"
            Margin="0,0,0,15"
            BeginningEdit="DataGrid_BeginningEdit"
            SelectionChanged="DataGrid_SelectionChanged">

            <!-- Group -->
            <DataGrid.GroupStyle>

                <GroupStyle>

                    <GroupStyle.ContainerStyle>

                        <Style TargetType="{x:Type GroupItem}">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="{x:Type GroupItem}">

                                        <Expander
                                            IsExpanded="True"
                                            Background="#E0E0E0"
                                            BorderBrush="#C0C0C0"
                                            BorderThickness="0,0,0,1">

                                            <Expander.Header>

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontWeight="Bold"
                                                    Margin="4,2"/>

                                            </Expander.Header>

                                            <ItemsPresenter/>

                                        </Expander>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </GroupStyle.ContainerStyle>

                </GroupStyle>

            </DataGrid.GroupStyle>


            <!-- Columns -->
            <DataGrid.Columns>

                <!-- Parameter Name -->
                <DataGridTextColumn
                    Header="Parameter"
                    Binding="{Binding Name}"
                    Width="2*"
                    IsReadOnly="True"/>


                <!-- Parameter Value -->
                <DataGridTextColumn
                    Header="Value"
                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    Width="2*">

                    <DataGridTextColumn.CellStyle>

                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True" >
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                    <Setter Property="BorderBrush" Value="#C62828"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                    </DataGridTextColumn.CellStyle>

                </DataGridTextColumn>


                <!-- Storage Type -->
                <DataGridTextColumn
                    Header="Type"
                    Binding="{Binding StorageType}"
                    Width="*"
                    IsReadOnly="True"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- Bottom buttons -->
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Width="100"
                Height="32"
                Margin="0,0,10,0"
                Content="Refresh"
                Command="{Binding RefreshCommand}"/>

            <Button
                Width="100"
                Height="32"
                Content="Apply"
                Command="{Binding ApplyCommand}"
                Background="#1976D2"
                BorderBrush="#1976D2"
                Foreground="White"/>

        </StackPanel>

    </Grid>

</Window>